# EmailJS (https://www.emailjs.com/) — used by the contact form.
# Copy this file to .env and fill in values from the EmailJS dashboard.
# Template variables expected: from_name, from_email, phone, company, service, volume, message

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
